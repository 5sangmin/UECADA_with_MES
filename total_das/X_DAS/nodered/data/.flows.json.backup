[{"id":"e9fb7e265eb77e88","type":"tab","label":"X_DAS OPC UA Bridge","disabled":false,"info":"PLC LINE1/2/3 and Sensor DAS OPC UA subscriptions are normalized and written to the Spring Boot OPC UA endpoint.\n\nns=2 : legacy X_DAS nodes  (54880, unchanged – BE compatibility)\nns=3 : new snake_case standard nodes  (54880, same server)\nCommand server: 55880  (ns=2 for command request/response)"},{"id":"78c4e55f5ef62ba8","type":"tab","label":"X_DAS Command Server (55880)","disabled":false,"info":"Command OPC UA server on port 55880.\nns=2 tree:\n  CMD.<lineId>.<equipmentId>.request.command_id\n  CMD.<lineId>.<equipmentId>.request.equipment_id\n  CMD.<lineId>.<equipmentId>.request.command_type\n  CMD.<lineId>.<equipmentId>.request.value\n  CMD.<lineId>.<equipmentId>.request.execute   (Boolean trigger)\n  CMD.<lineId>.<equipmentId>.response.status\n  CMD.<lineId>.<equipmentId>.response.accepted\n  CMD.<lineId>.<equipmentId>.response.error\n  CMD.<lineId>.<equipmentId>.response.updated_at\n\nWhen 'execute' flips to true the fn_dispatch_command node reads the\nrequest fields and sends the command toward the target line-das endpoint."},{"id":"ep_plc_line1","type":"OpcUa-Endpoint","name":"PLC LINE1 endpoint","endpoint":"${PLC_LINE1_ENDPOINT}","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"ep_plc_line2","type":"OpcUa-Endpoint","name":"PLC LINE2 endpoint","endpoint":"${PLC_LINE2_ENDPOINT}","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"ep_plc_line3","type":"OpcUa-Endpoint","name":"PLC LINE3 endpoint","endpoint":"${PLC_LINE3_ENDPOINT}","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"ep_sensor_das","type":"OpcUa-Endpoint","name":"Sensor DAS endpoint","endpoint":"${SENSOR_DAS_ENDPOINT}","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"ep_backend_spring","type":"OpcUa-Endpoint","name":"Spring Boot backend endpoint","endpoint":"${BACKEND_OPCUA_ENDPOINT}","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"76b7ac8f4fd1adf9","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"8a75cdacf66e5e79","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"5f11c564b3d42324","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"187dd806b3bcdb38","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"f12118a10287a7dc","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"1d1bb3aec653f65b","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"0a3fa2d1a935a0ae","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"4a96b6306f1404c9","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"5583fa9345aa0cc8","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"caff59c45c2364f7","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"dbdd0a2ed4dc7c93","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"6e1355a2d4ad3ec5","type":"OpcUa-Endpoint","name":"CMD server self (55880)","endpoint":"opc.tcp://127.0.0.1:55880/UA/X_DAS_CMD","secpol":"None","secmode":"None","none":true,"login":false,"usercert":false,"usercertificate":"","userprivatekey":""},{"id":"2adc4ee3020851c9","type":"comment","z":"e9fb7e265eb77e88","name":"ns=2 legacy + ns=3 standard + 55880 command server","info":"ns=2 (54880): X_DAS.LINE_01.CNC_01.data.spindle_speed  ← BE 호환 유지\nns=3 (54880): XDAS.line01.cnc01.data.spindle_speed     ← 신규 snake_case\nns=2 (55880): CMD.line01.cnc01.request.command_type    ← 명령 채널","x":470,"y":60,"wires":[]},{"id":"bd337fb7ea02a893","type":"inject","z":"e9fb7e265eb77e88","name":"Start subscriptions","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"30","crontab":"","once":true,"onceDelay":20,"topic":"","payload":"","payloadType":"date","x":150,"y":160,"wires":[["5d51bad3b1375f30"]]},{"id":"5d51bad3b1375f30","type":"function","z":"e9fb7e265eb77e88","name":"Build source subscriptions","func":"const interval = Number(env.get('OPCUA_SUB_INTERVAL_MS') || 1000);\nconst maxAttempts = Number(env.get('OPCUA_SUB_ATTEMPTS') || 3);\nconst attempt = Number(flow.get('subscription_attempts') || 0) + 1;\nif (attempt > maxAttempts) {\n  node.status({ fill: 'green', shape: 'dot', text: `subscriptions already attempted ${maxAttempts} times` });\n  return null;\n}\nflow.set('subscription_attempts', attempt);\n// ── RESET address-space registration maps on each subscription rebuild ──────\nflow.set('xdas_ns2_registered', {});\nflow.set('xdas_ns3_registered', {});\n\nconst lines = ['LINE-01', 'LINE-02', 'LINE-03'];\nconst equipments = ['CAST-01', 'CNC-01', 'CNC-02', 'CNC-03', 'WASH-01', 'ASSY-01', 'ASSY-02', 'TEST-01', 'TEST-02'];\n\nconst processTagsByEquipment = {\n  'CAST-01': [\n    ['power','Boolean'],['injection_pressure_sp','Double'],['mold_temperature_sp','Double'],\n    ['cooling_flow_sp','Double'],['injection_pressure','Double'],['mold_temperature','Double'],\n    ['cooling_flow','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'CNC-01': [\n    ['power','Boolean'],['spindle_speed_sp','Int32'],['tool_usage_sp','Double'],\n    ['coolant_flow_sp','Double'],['spindle_speed','Int32'],['tool_usage','Double'],\n    ['coolant_flow','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'CNC-02': [\n    ['power','Boolean'],['spindle_speed_sp','Int32'],['tool_usage_sp','Double'],\n    ['coolant_flow_sp','Double'],['spindle_speed','Int32'],['tool_usage','Double'],\n    ['coolant_flow','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'CNC-03': [\n    ['power','Boolean'],['spindle_speed_sp','Int32'],['tool_usage_sp','Double'],\n    ['coolant_flow_sp','Double'],['spindle_speed','Int32'],['tool_usage','Double'],\n    ['coolant_flow','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'WASH-01': [\n    ['power','Boolean'],['cleaning_concentration_sp','Double'],['cleaning_temperature_sp','Double'],\n    ['cleaning_pressure_sp','Double'],['cleaning_concentration','Double'],['cleaning_temperature','Double'],\n    ['cleaning_pressure','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'ASSY-01': [\n    ['power','Boolean'],['tightening_torque_sp','Double'],['tightening_angle_sp','Double'],\n    ['press_force_sp','Double'],['tightening_torque','Double'],['tightening_angle','Double'],\n    ['press_force','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'ASSY-02': [\n    ['power','Boolean'],['tightening_torque_sp','Double'],['tightening_angle_sp','Double'],\n    ['press_force_sp','Double'],['tightening_torque','Double'],['tightening_angle','Double'],\n    ['press_force','Double'],['progress','Double'],['cycle_time','Double']\n  ],\n  'TEST-01': [\n    ['power','Boolean'],['bore_dimension_sp','Double'],['hole_dimension_sp','Double'],\n    ['bore_dimension','Double'],['hole_dimension','Double'],['result_ok','Boolean'],\n    ['progress','Double'],['cycle_time','Double']\n  ],\n  'TEST-02': [\n    ['power','Boolean'],['bore_dimension_sp','Double'],['hole_dimension_sp','Double'],\n    ['bore_dimension','Double'],['hole_dimension','Double'],['result_ok','Boolean'],\n    ['progress','Double'],['cycle_time','Double']\n  ]\n};\n\nconst sensorDasTags = [\n  ['vibration_rms','Double'],['vibration_sample_rate_hz','Double'],['vibration_window_size','Double'],\n  ['vibration_stride','Double'],['vibration_raw_length','Double'],\n  ['current_a','Double'],['voltage_v','Double'],['control_voltage_v','Double'],\n  ['equipment_temperature_c','Double'],['operation_state','String'],\n  ['health_state','String'],['updated_at','String']\n];\n\nfunction clean(v) { return String(v).replace(/[^A-Za-z0-9_]/g, '_'); }\nfunction ns2LineId(id) { return id.replace('-', '_'); }\nfunction ns2EqId(id)   { return id.replace('-', '_'); }\nfunction ns3LineId(id) { return id.replace('-', '').toLowerCase(); }   // LINE-01 -> line01\nfunction ns3EqId(id)   { return id.replace('-', '').toLowerCase(); }   // CNC-01  -> cnc01\n\nfunction makeLineTags(lineId) {\n  const result = [];\n  const l2 = ns2LineId(lineId);\n  const l3 = ns3LineId(lineId);\n  // top-level line tags\n  for (const field of ['line_ts', 'payload', 'schema_version']) {\n    result.push({\n      name: `${lineId}.${field}`,\n      sourceNodeId: `ns=2;s=${lineId}.${field}`,\n      targetNodeId_ns2: `ns=2;s=X_DAS.${l2}.${field}`,\n      targetNodeId_ns3: `ns=3;s=XDAS.${l3}.${field}`,\n      datatype: 'String'\n    });\n  }\n  for (const equipmentId of equipments) {\n    const e2 = ns2EqId(equipmentId);\n    const e3 = ns3EqId(equipmentId);\n    for (const [field, dt] of [['status','String'],['ts','String'],['quality','String']]) {\n      result.push({\n        name: `${lineId}.${equipmentId}.${field}`,\n        sourceNodeId: `ns=2;s=${lineId}.${equipmentId}.${field}`,\n        targetNodeId_ns2: `ns=2;s=X_DAS.${l2}.${e2}.${field}`,\n        targetNodeId_ns3: `ns=3;s=XDAS.${l3}.${e3}.${field}`,\n        datatype: dt\n      });\n    }\n    const processTags = processTagsByEquipment[equipmentId] || [];\n    for (const [tagName, dt] of processTags) {\n      result.push({\n        name: `${lineId}.${equipmentId}.data.${tagName}`,\n        sourceNodeId: `ns=2;s=${lineId}.${equipmentId}.data.${tagName}`,\n        targetNodeId_ns2: `ns=2;s=X_DAS.${l2}.${e2}.data.${tagName}`,\n        targetNodeId_ns3: `ns=3;s=XDAS.${l3}.${e3}.data.${tagName}`,\n        datatype: dt\n      });\n    }\n  }\n  return result;\n}\n\nfunction makeSensorDasTags() {\n  const result = [];\n  for (const lineId of lines) {\n    for (const equipmentId of equipments) {\n      const l2 = ns2LineId(lineId);\n      const e2 = ns2EqId(equipmentId);\n      const l3 = ns3LineId(lineId);\n      const e3 = ns3EqId(equipmentId);\n      const sl = clean(lineId);\n      const se = clean(equipmentId);\n      for (const [tagName, dt] of sensorDasTags) {\n        result.push({\n          name: `${lineId}.${equipmentId}.sensor.${tagName}`,\n          sourceNodeId: `ns=1;s=DAS_${sl}_${se}_${tagName}`,\n          targetNodeId_ns2: `ns=2;s=X_DAS.${l2}.${e2}.sensor.${tagName}`,\n          targetNodeId_ns3: `ns=3;s=XDAS.${l3}.${e3}.sensor.${tagName}`,\n          datatype: dt\n        });\n      }\n    }\n  }\n  return result;\n}\n\nconst sources = {\n  LINE1: makeLineTags('LINE-01'),\n  LINE2: makeLineTags('LINE-02'),\n  LINE3: makeLineTags('LINE-03'),\n  SENSOR_DAS: makeSensorDasTags()\n};\nconst outputOrder = ['LINE1', 'LINE2', 'LINE3', 'SENSOR_DAS'];\nlet total = 0;\n\nfor (const [sourceKey, tags] of Object.entries(sources)) {\n  const bySource = {};\n  for (const tag of tags) bySource[tag.sourceNodeId] = tag;\n  flow.set(`${sourceKey}_TAGS_BY_SOURCE`, bySource);\n  total += tags.length;\n}\n\nfor (const [sourceKey, tags] of Object.entries(sources)) {\n  const outputIndex = outputOrder.indexOf(sourceKey);\n  for (const tag of tags) {\n    const outputs = outputOrder.map(() => null);\n    outputs[outputIndex] = {\n      payload: interval, interval,\n      topic: `${tag.sourceNodeId};datatype=${tag.datatype}`,\n      sourceKey,\n      tagName: tag.name,\n      sourceNodeId: tag.sourceNodeId,\n      targetNodeId_ns2: tag.targetNodeId_ns2,\n      targetNodeId_ns3: tag.targetNodeId_ns3,\n      datatype: tag.datatype\n    };\n    node.send(outputs);\n  }\n}\nnode.status({ fill: 'blue', shape: 'dot', text: `subscriptions: ${total}, attempt ${attempt}/${maxAttempts}` });\nreturn null;","outputs":4,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":160,"wires":[["c80dbc0510325870"],["8fa45fd80563636e"],["b1952de63b34795c"],["9757bddd92baf714"]]},{"id":"c80dbc0510325870","type":"OpcUa-Client","z":"e9fb7e265eb77e88","endpoint":"ep_plc_line1","action":"subscribe","deadbandtype":"a","deadbandvalue":1,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"PLC LINE1 subscribe","applicationName":"X_DAS Node-RED","applicationUri":"urn:x-das:node-red","x":650,"y":120,"wires":[["a5390922dbd057dc"],["6e691e56bf38c67b"],["6e691e56bf38c67b"]]},{"id":"8fa45fd80563636e","type":"OpcUa-Client","z":"e9fb7e265eb77e88","endpoint":"ep_plc_line2","action":"subscribe","deadbandtype":"a","deadbandvalue":1,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"PLC LINE2 subscribe","applicationName":"X_DAS Node-RED","applicationUri":"urn:x-das:node-red","x":650,"y":180,"wires":[["dc03dce0a8df7584"],["6e691e56bf38c67b"],["6e691e56bf38c67b"]]},{"id":"b1952de63b34795c","type":"OpcUa-Client","z":"e9fb7e265eb77e88","endpoint":"ep_plc_line3","action":"subscribe","deadbandtype":"a","deadbandvalue":1,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"PLC LINE3 subscribe","applicationName":"X_DAS Node-RED","applicationUri":"urn:x-das:node-red","x":650,"y":240,"wires":[["f8eced048efc6cf3"],["6e691e56bf38c67b"],["6e691e56bf38c67b"]]},{"id":"9757bddd92baf714","type":"OpcUa-Client","z":"e9fb7e265eb77e88","endpoint":"ep_sensor_das","action":"subscribe","deadbandtype":"n","deadbandvalue":0,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"Sensor DAS subscribe","applicationName":"X_DAS Node-RED","applicationUri":"urn:x-das:node-red","x":650,"y":300,"wires":[["fbac60659636de25"],["6e691e56bf38c67b"],["6e691e56bf38c67b"]]},{"id":"a5390922dbd057dc","type":"function","z":"e9fb7e265eb77e88","name":"Normalize LINE1 for backend","func":"\nconst sourceKey = 'LINE1';\nconst originalTopic = String(msg.sourceNodeId || msg.topic || '');\nconst sourceNodeId = originalTopic.replace(/;datatype=.*$/, '');\nif (!sourceNodeId.startsWith('ns=')) return null;\nconst tagMap = flow.get(`${sourceKey}_TAGS_BY_SOURCE`) || {};\nconst tag = tagMap[sourceNodeId];\nif (!tag) {\n  node.status({ fill: 'yellow', shape: 'ring', text: `unmapped ${sourceNodeId}` });\n  node.warn(`No backend mapping for ${sourceKey} topic: ${originalTopic}`);\n  return null;\n}\nlet value = msg.payload;\nif (value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'value')) {\n  value = value.value;\n}\nmsg.payload = value;\n// Keep ns=2 topic for downstream (legacy path)\nmsg.topic = `${tag.targetNodeId_ns2};datatype=${tag.datatype}`;\nmsg.xDas = {\n  source: sourceKey,\n  tag: tag.name,\n  sourceNodeId,\n  targetNodeId_ns2: tag.targetNodeId_ns2,\n  targetNodeId_ns3: tag.targetNodeId_ns3,\n  datatype: tag.datatype,\n  statusCode: msg.statusCode,\n  sourceTimestamp: msg.sourceTimestamp,\n  serverTimestamp: msg.serverTimestamp,\n  receivedAt: new Date().toISOString()\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":940,"y":40,"wires":[["cd4e2df16eef1e96"]]},{"id":"dc03dce0a8df7584","type":"function","z":"e9fb7e265eb77e88","name":"Normalize LINE2 for backend","func":"\nconst sourceKey = 'LINE2';\nconst originalTopic = String(msg.sourceNodeId || msg.topic || '');\nconst sourceNodeId = originalTopic.replace(/;datatype=.*$/, '');\nif (!sourceNodeId.startsWith('ns=')) return null;\nconst tagMap = flow.get(`${sourceKey}_TAGS_BY_SOURCE`) || {};\nconst tag = tagMap[sourceNodeId];\nif (!tag) {\n  node.status({ fill: 'yellow', shape: 'ring', text: `unmapped ${sourceNodeId}` });\n  node.warn(`No backend mapping for ${sourceKey} topic: ${originalTopic}`);\n  return null;\n}\nlet value = msg.payload;\nif (value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'value')) {\n  value = value.value;\n}\nmsg.payload = value;\n// Keep ns=2 topic for downstream (legacy path)\nmsg.topic = `${tag.targetNodeId_ns2};datatype=${tag.datatype}`;\nmsg.xDas = {\n  source: sourceKey,\n  tag: tag.name,\n  sourceNodeId,\n  targetNodeId_ns2: tag.targetNodeId_ns2,\n  targetNodeId_ns3: tag.targetNodeId_ns3,\n  datatype: tag.datatype,\n  statusCode: msg.statusCode,\n  sourceTimestamp: msg.sourceTimestamp,\n  serverTimestamp: msg.serverTimestamp,\n  receivedAt: new Date().toISOString()\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":940,"y":100,"wires":[["cd4e2df16eef1e96"]]},{"id":"f8eced048efc6cf3","type":"function","z":"e9fb7e265eb77e88","name":"Normalize LINE3 for backend","func":"\nconst sourceKey = 'LINE3';\nconst originalTopic = String(msg.sourceNodeId || msg.topic || '');\nconst sourceNodeId = originalTopic.replace(/;datatype=.*$/, '');\nif (!sourceNodeId.startsWith('ns=')) return null;\nconst tagMap = flow.get(`${sourceKey}_TAGS_BY_SOURCE`) || {};\nconst tag = tagMap[sourceNodeId];\nif (!tag) {\n  node.status({ fill: 'yellow', shape: 'ring', text: `unmapped ${sourceNodeId}` });\n  node.warn(`No backend mapping for ${sourceKey} topic: ${originalTopic}`);\n  return null;\n}\nlet value = msg.payload;\nif (value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'value')) {\n  value = value.value;\n}\nmsg.payload = value;\n// Keep ns=2 topic for downstream (legacy path)\nmsg.topic = `${tag.targetNodeId_ns2};datatype=${tag.datatype}`;\nmsg.xDas = {\n  source: sourceKey,\n  tag: tag.name,\n  sourceNodeId,\n  targetNodeId_ns2: tag.targetNodeId_ns2,\n  targetNodeId_ns3: tag.targetNodeId_ns3,\n  datatype: tag.datatype,\n  statusCode: msg.statusCode,\n  sourceTimestamp: msg.sourceTimestamp,\n  serverTimestamp: msg.serverTimestamp,\n  receivedAt: new Date().toISOString()\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":940,"y":160,"wires":[["cd4e2df16eef1e96"]]},{"id":"fbac60659636de25","type":"function","z":"e9fb7e265eb77e88","name":"Normalize Sensor DAS for backend","func":"\nconst sourceKey = 'SENSOR_DAS';\nconst originalTopic = String(msg.sourceNodeId || msg.topic || '');\nconst sourceNodeId = originalTopic.replace(/;datatype=.*$/, '');\nif (!sourceNodeId.startsWith('ns=')) return null;\nconst tagMap = flow.get(`${sourceKey}_TAGS_BY_SOURCE`) || {};\nconst tag = tagMap[sourceNodeId];\nif (!tag) {\n  node.status({ fill: 'yellow', shape: 'ring', text: `unmapped ${sourceNodeId}` });\n  node.warn(`No backend mapping for ${sourceKey} topic: ${originalTopic}`);\n  return null;\n}\nlet value = msg.payload;\nif (value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'value')) {\n  value = value.value;\n}\nmsg.payload = value;\n// Keep ns=2 topic for downstream (legacy path)\nmsg.topic = `${tag.targetNodeId_ns2};datatype=${tag.datatype}`;\nmsg.xDas = {\n  source: sourceKey,\n  tag: tag.name,\n  sourceNodeId,\n  targetNodeId_ns2: tag.targetNodeId_ns2,\n  targetNodeId_ns3: tag.targetNodeId_ns3,\n  datatype: tag.datatype,\n  statusCode: msg.statusCode,\n  sourceTimestamp: msg.sourceTimestamp,\n  serverTimestamp: msg.serverTimestamp,\n  receivedAt: new Date().toISOString()\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":960,"y":200,"wires":[["cd4e2df16eef1e96"]]},{"id":"cd4e2df16eef1e96","type":"function","z":"e9fb7e265eb77e88","name":"Collect equipment snapshot / map BE schema","func":"const original = RED.util.cloneMessage(msg);\noriginal.backendWrite = false;\n\nconst tag = msg.xDas && msg.xDas.tag;\nif (!tag) return [original, null];\n\nconst snapshots  = flow.get('backend_equipment_snapshots') || {};\nconst cycleState = flow.get('backend_cycle_state') || {};\nconst out  = [original];\nconst now  = Date.now();\nconst nowIso = new Date(now).toISOString();\n\n// ── BE schema map (ns=2 legacy – UNCHANGED) ─────────────────────────────────\nconst EQUIPMENT_CODE = {\n  'CAST-01':'CAST01','CNC-01':'CNC01','CNC-02':'CNC02','CNC-03':'CNC03',\n  'WASH-01':'WASH01','ASSY-01':'ASSY01','ASSY-02':'ASSY02',\n  'TEST-01':'TEST01','TEST-02':'TEST02'\n};\nconst PLC_MAP = {\n  'CAST-01': { 'data.injection_pressure':['InjectionPressure','Double'],   'data.mold_temperature':['MoldTemperature','Double'],   'data.cooling_flow':['CoolingFlow','Double'],  'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'CNC-01':  { 'data.spindle_speed':['SpindleSpeed','Int32'],               'data.tool_usage':['ToolUsage','Double'],                'data.coolant_flow':['CoolantFlow','Double'],  'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'CNC-02':  { 'data.spindle_speed':['SpindleSpeed','Int32'],               'data.tool_usage':['ToolUsage','Double'],                'data.coolant_flow':['CoolantFlow','Double'],  'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'CNC-03':  { 'data.spindle_speed':['SpindleSpeed','Int32'],               'data.tool_usage':['ToolUsage','Double'],                'data.coolant_flow':['CoolantFlow','Double'],  'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'WASH-01': { 'data.cleaning_concentration':['CleaningConcentration','Double'],'data.cleaning_temperature':['CleaningTemperature','Double'],'data.cleaning_pressure':['CleaningPressure','Double'],'data.cycle_time':['CycleTime','Double'],'status':['Status','Int32','statusCode'] },\n  'ASSY-01': { 'data.tightening_torque':['TighteningTorque','Double'],      'data.tightening_angle':['TighteningAngle','Double'],   'data.press_force':['PressForce','Double'],    'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'ASSY-02': { 'data.tightening_torque':['TighteningTorque','Double'],      'data.tightening_angle':['TighteningAngle','Double'],   'data.press_force':['PressForce','Double'],    'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'TEST-01': { 'data.bore_dimension':['BoreDimension','Double'],            'data.hole_dimension':['HoleDimension','Double'],       'data.result_ok':['ResultOk','Boolean'],       'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] },\n  'TEST-02': { 'data.bore_dimension':['BoreDimension','Double'],            'data.hole_dimension':['HoleDimension','Double'],       'data.result_ok':['ResultOk','Boolean'],       'data.cycle_time':['CycleTime','Double'], 'status':['Status','Int32','statusCode'] }\n};\nconst SENSOR_MAP = {\n  'vibration_rms':        ['SensorVibration',   'Double', 'vibration'],\n  'current_a':            ['SensorCurrent',      'Double', 'current'],\n  'voltage_v':            ['SensorVoltage',      'Double', 'voltage'],\n  'equipment_temperature_c':['SensorTemperature','Double', 'temperature']\n};\n\n// ── helpers ──────────────────────────────────────────────────────────────────\nfunction parseTag(tagName) {\n  const parts = String(tagName).split('.');\n  if (parts.length < 2) return null;\n  const lineId = parts[0], equipmentId = parts[1];\n  if (!EQUIPMENT_CODE[equipmentId]) return null;\n  if (parts[2] === 'sensor') return { lineId, equipmentId, kind: 'sensor', field: parts.slice(3).join('.') };\n  if (parts[2] === 'data')   return { lineId, equipmentId, kind: 'plc',    field: 'data.' + parts.slice(3).join('.') };\n  return { lineId, equipmentId, kind: 'plc', field: parts.slice(2).join('.') };\n}\nfunction lineCode(id)   { return String(id).replace('-', ''); }\nfunction statusCode(v)  {\n  if (typeof v === 'number') return v;\n  const s = String(v || '').toUpperCase();\n  if (s==='RUN'||s==='ON'||s==='GOOD') return 1;\n  if (s==='OFF'||s==='STOP')            return 0;\n  if (s==='WARNING'||s==='UNCERTAIN')  return 2;\n  if (s==='DANGER'||s==='ALARM'||s==='BAD') return 3;\n  return -1;\n}\nfunction numeric(v, fb=0) { const n=Number(v); return Number.isFinite(n)?n:fb; }\nfunction updateCycle(lineId, equipmentId, value, mode) {\n  const key = lineId+'.'+equipmentId;\n  const st = cycleState[key]||{acc:0,count:0,startedAt:now,lastCycleTime:0};\n  st.acc += Math.max(0, numeric(value, 0));\n  if (st.acc >= 1) { st.count++; st.lastCycleTime=Math.max(0,+((now-(st.startedAt||now))/1000).toFixed(3)); st.acc=st.acc%1; st.startedAt=now; }\n  cycleState[key] = st;\n  return mode==='cycleCount' ? st.count : st.lastCycleTime;\n}\nfunction ensureSnapshot(lineId, equipmentId) {\n  const key = lineId+'.'+equipmentId;\n  const snap = snapshots[key]||{lineId,equipmentId,plc:{},sensor:{},updatedAt:nowIso};\n  snap.updatedAt = nowIso; snapshots[key] = snap; return snap;\n}\n\n// ── ns=2 legacy BE emit (UNCHANGED – backend compatibility) ──────────────────\nfunction typedMsg_ns2(nodeName, datatype, value, meta, beWrite=true) {\n  return {\n    topic: 'ns=2;s='+nodeName+';datatype='+datatype,\n    payload: value, backendWrite: beWrite,\n    xDas: Object.assign({}, msg.xDas||{}, meta||{}, {\n      backendNodeId: 'ns=2;s='+nodeName, backendDatatype: datatype, backendWrite: beWrite\n    })\n  };\n}\nfunction emitBackend(lineId, equipmentId, fieldName, datatype, value, meta) {\n  const eqCode    = EQUIPMENT_CODE[equipmentId];\n  const scopedName = lineCode(lineId)+'.'+eqCode+'.'+fieldName;\n  out.push(typedMsg_ns2(scopedName, datatype, value, meta, true));\n  if (lineId === 'LINE-01') {\n    out.push(typedMsg_ns2(eqCode+'.'+fieldName, datatype, value, meta, true));\n  }\n}\nfunction emitSnapshot(lineId, equipmentId, snap) {\n  const eqCode = EQUIPMENT_CODE[equipmentId];\n  const payload = JSON.stringify({ line_id:lineId, equipment_id:equipmentId, equipment_code:eqCode, plc:snap.plc, sensor:snap.sensor, updated_at:snap.updatedAt });\n  emitBackend(lineId, equipmentId, 'Payload', 'String', payload, { backendField:'Payload' });\n}\n\n// ── ns=3 standard emit (NEW) ─────────────────────────────────────────────────\nfunction ns3EqId(id) { return id.replace('-','').toLowerCase(); }  // CNC-01 -> cnc01\nfunction ns3LineId(id){ return id.replace('-','').toLowerCase(); }  // LINE-01 -> line01\nfunction typedMsg_ns3(nodeName, datatype, value) {\n  return {\n    topic: 'ns=3;s='+nodeName+';datatype='+datatype,\n    payload: value, backendWrite: false,\n    xDas: { ns3NodeId: 'ns=3;s='+nodeName, backendDatatype: datatype, backendWrite: false }\n  };\n}\nfunction emitStandard(lineId, equipmentId, bucket, field, datatype, value) {\n  const l = ns3LineId(lineId), e = ns3EqId(equipmentId);\n  const nodeName = 'XDAS.'+l+'.'+e+'.'+bucket+'.'+field;\n  out.push(typedMsg_ns3(nodeName, datatype, value));\n}\n\n// ── process tag ──────────────────────────────────────────────────────────────\nconst parsed = parseTag(tag);\nif (!parsed) return [out, null];\n\nconst snap  = ensureSnapshot(parsed.lineId, parsed.equipmentId);\nlet   value = msg.payload;\n\nif (parsed.kind === 'sensor') {\n  const sensorTarget = SENSOR_MAP[parsed.field];\n  if (sensorTarget) {\n    const [backendField, datatype, snapField] = sensorTarget;\n    value = numeric(value);\n    snap.sensor[snapField] = value;\n    snap.sensor.updated_at = nowIso;\n    // ns=2 BE\n    emitBackend(parsed.lineId, parsed.equipmentId, backendField, datatype, value, { backendField, sourceKind:'sensor' });\n    emitSnapshot(parsed.lineId, parsed.equipmentId, snap);\n    // ns=3 standard\n    emitStandard(parsed.lineId, parsed.equipmentId, 'sensor', parsed.field, datatype, value);\n  }\n} else {\n  const plcTarget = PLC_MAP[parsed.equipmentId] && PLC_MAP[parsed.equipmentId][parsed.field];\n  if (plcTarget) {\n    const [backendField, datatype, transform] = plcTarget;\n    if      (transform==='statusCode') value = statusCode(value);\n    else if (transform==='cycleTime')  value = updateCycle(parsed.lineId, parsed.equipmentId, value, transform);\n    else if (transform==='cycleCount') value = updateCycle(parsed.lineId, parsed.equipmentId, value, transform);\n    else if (datatype==='Double')  value = numeric(value);\n    else if (datatype==='Int32')   value = Math.trunc(numeric(value));\n    else if (datatype==='Boolean') value = !!value;\n\n    snap.plc[backendField] = value;\n    snap.plc.updated_at = nowIso;\n    // ns=2 BE\n    emitBackend(parsed.lineId, parsed.equipmentId, backendField, datatype, value, { backendField, sourceKind:'plc' });\n    if (backendField === 'Status') {\n      snap.plc.AlarmCode = snap.plc.AlarmCode || 0;\n      emitBackend(parsed.lineId, parsed.equipmentId, 'AlarmCode', 'Int32', snap.plc.AlarmCode, { backendField:'AlarmCode', sourceKind:'derived' });\n    }\n    emitSnapshot(parsed.lineId, parsed.equipmentId, snap);\n    // ns=3 standard  (field -> bucket 자동 분류: sp접미사=setpoint, 나머지=data)\n    const is_sp = parsed.field.endsWith('_sp');\n    const bucket = is_sp ? 'setpoint' : 'data';\n    emitStandard(parsed.lineId, parsed.equipmentId, bucket, parsed.field.replace(/^data\\./, ''), datatype, value);\n  }\n}\n\nflow.set('backend_equipment_snapshots', snapshots);\nflow.set('backend_cycle_state', cycleState);\nnode.status({ fill:'green', shape:'dot', text:'BE+ns3 mapped '+(out.length-1)+' node(s)' });\n\nlet debugMessage = null;\nconst lastDebugAt = Number(flow.get('xdas_live_debug_last_ms')||0);\nif (out.length > 1 && now - lastDebugAt >= 1000) {\n  flow.set('xdas_live_debug_last_ms', now);\n  debugMessage = {\n    topic: parsed.lineId+'.'+parsed.equipmentId,\n    payload: {\n      received_at: nowIso, source: msg.xDas&&msg.xDas.source,\n      source_tag: tag, source_node_id: msg.xDas&&msg.xDas.sourceNodeId,\n      source_value: msg.payload,\n      backend_nodes: out.slice(1).map(m=>({ node_id:m.xDas&&m.xDas.backendNodeId, datatype:m.xDas&&m.xDas.backendDatatype, field:m.xDas&&m.xDas.backendField, value:m.payload })),\n      snapshot: snap\n    }\n  };\n}\nreturn [out, debugMessage];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1340,"y":120,"wires":[["519a0b8c06bd263b"],["9cacbee8caf93ef7"]]},{"id":"519a0b8c06bd263b","type":"function","z":"e9fb7e265eb77e88","name":"Publish X_DAS OPC UA (ns=2 + ns=3) / optional BE write","func":"const enabled = /^(1|true|yes|on)$/i.test(String(env.get('BACKEND_OPCUA_WRITE_ENABLED')||'false'));\nconst shouldWriteBackend = enabled && msg.backendWrite === true;\nconst topic = String(msg.topic || '');\nconst match = topic.match(/^ns=(\\d+);s=([^;]+);datatype=([^;]+)$/);\nif (!match) {\n  node.warn(`Cannot publish X_DAS OPC UA value without typed topic: ${topic}`);\n  return [null, shouldWriteBackend ? msg : null];\n}\n\nconst namespace    = Number(match[1]);\nconst variableName = match[2];\nconst datatype     = match[3];\n\n// ── registration map – separate keys for ns=2 and ns=3 ──────────────────────\n// This prevents \"Variable not found\" races: addVariable is sent only once per\n// server address space per subscription cycle (reset in fn_build_subscriptions).\nconst regKey   = namespace === 3 ? 'xdas_ns3_registered' : 'xdas_ns2_registered';\nconst registered = flow.get(regKey) || {};\nconst serverMessages = [];\n\nif (!registered[variableName]) {\n  serverMessages.push({\n    topic: `ns=${namespace};s=${variableName};datatype=${datatype};browseName=${variableName}`,\n    payload: { opcuaCommand: 'addVariable' }\n  });\n  registered[variableName] = true;\n  flow.set(regKey, registered);\n}\n\nserverMessages.push({\n  payload: {\n    messageType: 'Variable',\n    namespace,\n    variableName,\n    variableValue: msg.payload,\n    datatype\n  },\n  xDas: msg.xDas\n});\n\nnode.status({\n  fill: shouldWriteBackend ? 'green' : 'blue',\n  shape: 'dot',\n  text: shouldWriteBackend ? 'server+BE write' : `ns=${namespace} publish`\n});\nreturn [serverMessages, shouldWriteBackend ? msg : null];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1760,"y":120,"wires":[["08962d192799f39c","86968e7674757a7f"],["44bb09fa67d70693","7063cdeba12762c8"]]},{"id":"08962d192799f39c","type":"OpcUa-Server","z":"e9fb7e265eb77e88","port":"54880","name":"X_DAS OPC UA Server (54880)","endpoint":"UA/X_DAS","usersFile":"","nodesetDir":"","autoAcceptUnknownCertificate":true,"registerToDiscovery":false,"constructDefaultAddressSpace":true,"allowAnonymous":true,"endpointNone":true,"endpointSign":false,"endpointSignEncrypt":false,"endpointBasic128Rsa15":false,"endpointBasic256":false,"endpointBasic256Sha256":false,"maxNodesPerBrowse":0,"maxNodesPerHistoryReadData":0,"maxNodesPerHistoryReadEvents":0,"maxNodesPerHistoryUpdateData":0,"maxNodesPerRead":0,"maxNodesPerWrite":0,"maxNodesPerMethodCall":0,"maxNodesPerRegisterNodes":0,"maxNodesPerNodeManagement":0,"maxMonitoredItemsPerCall":0,"maxNodesPerHistoryUpdateEvents":0,"maxNodesPerTranslateBrowsePathsToNodeIds":0,"maxConnectionsPerEndpoint":20,"maxMessageSize":"10485760","maxBufferSize":"10485760","maxSessions":20,"x":2140,"y":80,"wires":[["787c4fa9ba1296e8"]]},{"id":"44bb09fa67d70693","type":"OpcUa-Client","z":"e9fb7e265eb77e88","endpoint":"ep_backend_spring","action":"write","deadbandtype":"a","deadbandvalue":1,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"Write to Spring Boot OPC UA","applicationName":"X_DAS Node-RED","applicationUri":"urn:x-das:node-red","x":2140,"y":140,"wires":[["a375d08e189b02a6"],["6e691e56bf38c67b"],["6e691e56bf38c67b"]]},{"id":"a375d08e189b02a6","type":"debug","z":"e9fb7e265eb77e88","name":"Backend write result","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":2420,"y":140,"wires":[]},{"id":"6e691e56bf38c67b","type":"debug","z":"e9fb7e265eb77e88","name":"OPC UA status","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1580,"y":360,"wires":[]},{"id":"7063cdeba12762c8","type":"debug","z":"e9fb7e265eb77e88","name":"Normalized sensor sample debug","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":1820,"y":160,"wires":[]},{"id":"9cacbee8caf93ef7","type":"debug","z":"e9fb7e265eb77e88","name":"X_DAS live receive sample","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":1400,"y":160,"wires":[]},{"id":"86968e7674757a7f","type":"debug","z":"e9fb7e265eb77e88","name":"Server publish (ns=2+ns=3)","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":1860,"y":80,"wires":[]},{"id":"787c4fa9ba1296e8","type":"debug","z":"e9fb7e265eb77e88","name":"54880 server result","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":2380,"y":80,"wires":[]},{"id":"6a9a50715172c408","type":"catch","z":"e9fb7e265eb77e88","name":"Catch flow errors","scope":null,"uncaught":false,"x":150,"y":400,"wires":[["1c38a419e7b68155"]]},{"id":"1c38a419e7b68155","type":"debug","z":"e9fb7e265eb77e88","name":"Flow errors","active":false,"tosidebar":true,"console":true,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":370,"y":400,"wires":[]},{"id":"e153518f61c9e9aa","type":"inject","z":"78c4e55f5ef62ba8","name":"Init command address space","props":[{"p":"payload"}],"repeat":"","crontab":"","once":true,"onceDelay":5,"topic":"","payload":"","payloadType":"date","x":150,"y":120,"wires":[["c12d64a912ad98c4"]]},{"id":"c12d64a912ad98c4","type":"function","z":"78c4e55f5ef62ba8","name":"Init CMD address space nodes","func":"// Register all CMD nodes in address space (ns=2 on the 55880 server)\n// Lines × Equipments × (request+response fields)\nconst lines = ['line01', 'line02', 'line03'];\nconst equipments = ['cast01','cnc01','cnc02','cnc03','wash01','assy01','assy02','test01','test02'];\nconst requestFields  = [\n  ['command_id',   'String'],\n  ['equipment_id', 'String'],\n  ['command_type', 'String'],\n  ['value',        'String'],\n  ['execute',      'Boolean']\n];\nconst responseFields = [\n  ['status',     'String'],\n  ['accepted',   'Boolean'],\n  ['error',      'String'],\n  ['updated_at', 'String']\n];\n\nconst msgs = [];\nfor (const line of lines) {\n  for (const eq of equipments) {\n    const base = `CMD.${line}.${eq}`;\n    for (const [field, dt] of requestFields) {\n      const name = `${base}.request.${field}`;\n      msgs.push({\n        topic: `ns=2;s=${name};datatype=${dt};browseName=${name}`,\n        payload: { opcuaCommand: 'addVariable' }\n      });\n    }\n    for (const [field, dt] of responseFields) {\n      const name = `${base}.response.${field}`;\n      msgs.push({\n        topic: `ns=2;s=${name};datatype=${dt};browseName=${name}`,\n        payload: { opcuaCommand: 'addVariable' }\n      });\n    }\n  }\n}\n\n// Mark all registered\nflow.set('cmd_ns2_registered', true);\nnode.status({ fill:'blue', shape:'dot', text:`addVariable: ${msgs.length} cmd nodes` });\nreturn [msgs];","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":120,"wires":[["628e4e06ea27c3e2"]]},{"id":"871f295d05b62661","type":"inject","z":"78c4e55f5ef62ba8","name":"Subscribe execute triggers","props":[{"p":"payload"}],"repeat":"","crontab":"","once":true,"onceDelay":8,"topic":"","payload":"","payloadType":"date","x":150,"y":200,"wires":[["a44a99cd9174b52e"]]},{"id":"a44a99cd9174b52e","type":"function","z":"78c4e55f5ef62ba8","name":"Build CMD execute subscriptions","func":"const lines      = ['line01','line02','line03'];\nconst equipments = ['cast01','cnc01','cnc02','cnc03','wash01','assy01','assy02','test01','test02'];\nconst interval   = 500;  // ms – faster poll for commands\nfor (const line of lines) {\n  for (const eq of equipments) {\n    const nodeId = `ns=2;s=CMD.${line}.${eq}.request.execute`;\n    node.send({\n      payload: interval, interval,\n      topic: `${nodeId};datatype=Boolean`\n    });\n  }\n}\nnode.status({ fill:'blue', shape:'dot', text:`cmd subscriptions sent: ${lines.length * equipments.length}` });\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":200,"wires":[["180c65ef18469a8b"]]},{"id":"180c65ef18469a8b","type":"OpcUa-Client","z":"78c4e55f5ef62ba8","endpoint":"6e1355a2d4ad3ec5","action":"subscribe","deadbandtype":"n","deadbandvalue":0,"time":500,"timeUnit":"ms","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"Subscribe CMD execute triggers","applicationName":"X_DAS Node-RED CMD","applicationUri":"urn:x-das:node-red:cmd","x":700,"y":200,"wires":[["293c521733963fda"],["686d126a7214a094"],["686d126a7214a094"]]},{"id":"293c521733963fda","type":"function","z":"78c4e55f5ef62ba8","name":"Dispatch CMD on execute=true","func":"// Fires only when execute flips to true\nlet value = msg.payload;\nif (value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value,'value')) value = value.value;\nif (!value) return null;  // execute=false – ignore\n\nconst topic = String(msg.sourceNodeId || msg.topic || '');\n// Extract line and equipment from ns=2;s=CMD.line01.cnc01.request.execute\nconst m = topic.match(/CMD\\.([^.]+)\\.([^.]+)\\.request\\.execute/);\nif (!m) { node.warn('CMD topic parse failed: '+topic); return null; }\n\nconst [, lineId, equipId] = m;\n\n// Read sibling request fields from address-space (or flow context cache)\n// For simplicity we emit a read request for each request field.\n// The downstream fn_execute_command receives all five values before writing.\nconst fields = ['command_id','equipment_id','command_type','value'];\nconst readMsgs = fields.map(f => ({\n  payload: null,\n  topic: `ns=2;s=CMD.${lineId}.${equipId}.request.${f};datatype=String`,\n  _cmd_meta: { lineId, equipId }\n}));\n\nnode.status({ fill:'yellow', shape:'dot', text:`execute ${lineId}.${equipId}` });\nreturn [readMsgs];","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1000,"y":200,"wires":[["9faa5cead7b32152"]]},{"id":"9faa5cead7b32152","type":"OpcUa-Client","z":"78c4e55f5ef62ba8","endpoint":"6e1355a2d4ad3ec5","action":"read","deadbandtype":"a","deadbandvalue":1,"time":1,"timeUnit":"s","certificate":"n","localfile":"","localkeyfile":"","securitymode":"None","securitypolicy":"None","useTransport":false,"maxChunkCount":64,"maxMessageSize":10485760,"receiveBufferSize":10485760,"sendBufferSize":10485760,"setstatusandtime":false,"keepsessionalive":true,"name":"Read CMD request fields","applicationName":"X_DAS Node-RED CMD","applicationUri":"urn:x-das:node-red:cmd","x":1260,"y":200,"wires":[["1d862ef9f3092328"],["686d126a7214a094"],["686d126a7214a094"]]},{"id":"1d862ef9f3092328","type":"function","z":"78c4e55f5ef62ba8","name":"Assemble and emit command","func":"// Collects read results into a command object and prepares the line-das write.\n// Each message from the read node carries one field value.\nconst meta  = msg._cmd_meta || {};\nconst topic = String(msg.topic || '');\nconst fieldMatch = topic.match(/request\\.([^;]+)/);\nconst field = fieldMatch ? fieldMatch[1] : null;\nif (!field) return null;\n\nconst ctx = context.get('cmd_accumulator') || {};\nconst key = (meta.lineId||'')+'.'+(meta.equipId||'');\nif (!ctx[key]) ctx[key] = { ts: Date.now(), fields: {} };\nctx[key].fields[field] = msg.payload;\nctx[key].ts = Date.now();\ncontext.set('cmd_accumulator', ctx);\n\nconst required = ['command_id','equipment_id','command_type','value'];\nconst collected = ctx[key].fields;\nconst ready = required.every(f => collected[f] !== undefined);\nif (!ready) return null;\n\n// All fields collected – build command message for line-das\nconst cmd = Object.assign({ lineId: meta.lineId, equipId: meta.equipId }, collected);\ndelete ctx[key];\ncontext.set('cmd_accumulator', ctx);\n\nnode.status({ fill:'green', shape:'dot', text:`CMD sent: ${cmd.command_type} -> ${cmd.lineId}.${cmd.equipId}` });\n\n// Emit the command for downstream (link out to line-das command dispatcher)\nreturn [{ payload: cmd, topic: 'command' }];","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1500,"y":200,"wires":[["12e99b37468ad14a","716b13a084866df2"]]},{"id":"12e99b37468ad14a","type":"link out","z":"78c4e55f5ef62ba8","name":"CMD -> line-das dispatcher","mode":"link","links":[],"x":1720,"y":200,"wires":[]},{"id":"7c99a99a7525d0f9","type":"link in","z":"78c4e55f5ef62ba8","name":"CMD response <- line-das","links":[],"x":150,"y":320,"wires":[["ff9f53f24814cc15"]]},{"id":"ff9f53f24814cc15","type":"function","z":"78c4e55f5ef62ba8","name":"Write CMD response to 55880","func":"// Receives command response from line-das and writes back to 55880 response nodes\nconst r = msg.payload || {};\nconst lineId  = r.lineId  || '';\nconst equipId = r.equipId || '';\nif (!lineId || !equipId) return null;\n\nconst base = `CMD.${lineId}.${equipId}.response`;\nconst nowIso = new Date().toISOString();\nconst statusVal   = String(r.status   || 'unknown');\nconst acceptedVal = !!r.accepted;\nconst errorVal    = String(r.error    || '');\n\nconst writes = [\n  { topic:`ns=2;s=${base}.status;datatype=String`,     payload: statusVal   },\n  { topic:`ns=2;s=${base}.accepted;datatype=Boolean`,  payload: acceptedVal },\n  { topic:`ns=2;s=${base}.error;datatype=String`,      payload: errorVal    },\n  { topic:`ns=2;s=${base}.updated_at;datatype=String`, payload: nowIso      }\n];\n\n// Reset execute flag\nwrites.push({\n  topic: `ns=2;s=CMD.${lineId}.${equipId}.request.execute;datatype=Boolean`,\n  payload: false\n});\n\n// Package as server update messages\nconst serverMsgs = writes.map(w => ({\n  payload: {\n    messageType: 'Variable',\n    namespace: 2,\n    variableName: w.topic.match(/ns=2;s=([^;]+)/)[1],\n    variableValue: w.payload,\n    datatype: w.topic.match(/datatype=([^;]+)/)[1]\n  }\n}));\n\nnode.status({ fill:'green', shape:'dot', text:`response written: ${lineId}.${equipId} ${statusVal}` });\nreturn [serverMsgs];","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":320,"wires":[["628e4e06ea27c3e2"]]},{"id":"628e4e06ea27c3e2","type":"OpcUa-Server","z":"78c4e55f5ef62ba8","d":true,"port":"55880","name":"X_DAS Command Server (55880)","endpoint":"UA/X_DAS_CMD","usersFile":"","nodesetDir":"","autoAcceptUnknownCertificate":true,"registerToDiscovery":false,"constructDefaultAddressSpace":true,"allowAnonymous":true,"endpointNone":true,"endpointSign":false,"endpointSignEncrypt":false,"endpointBasic128Rsa15":false,"endpointBasic256":false,"endpointBasic256Sha256":false,"maxNodesPerBrowse":0,"maxNodesPerHistoryReadData":0,"maxNodesPerHistoryReadEvents":0,"maxNodesPerHistoryUpdateData":0,"maxNodesPerRead":0,"maxNodesPerWrite":0,"maxNodesPerMethodCall":0,"maxNodesPerRegisterNodes":0,"maxNodesPerNodeManagement":0,"maxMonitoredItemsPerCall":0,"maxNodesPerHistoryUpdateEvents":0,"maxNodesPerTranslateBrowsePathsToNodeIds":0,"maxConnectionsPerEndpoint":20,"maxMessageSize":"10485760","maxBufferSize":"10485760","maxSessions":20,"x":1620,"y":80,"wires":[["c976b8294edab07b"]]},{"id":"c976b8294edab07b","type":"debug","z":"78c4e55f5ef62ba8","name":"CMD server result","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1920,"y":80,"wires":[]},{"id":"686d126a7214a094","type":"debug","z":"78c4e55f5ef62ba8","name":"CMD OPC UA status","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":920,"y":260,"wires":[]},{"id":"716b13a084866df2","type":"debug","z":"78c4e55f5ef62ba8","name":"CMD dispatched","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1720,"y":260,"wires":[]}]