    {
        "id": "4eada37e6d63337e",
        "type": "function",
        "z": "7fceb9f3fadf4c8d",
        "name": "mark COMPLETED",
        "func": "\nconst now = new Date().toISOString();\nconst c = msg.command;\nif (!c || !c.command_id) return null;\nconst statusMap = flow.get('command_status_map') || {};\nstatusMap[c.command_id] = Object.assign({}, statusMap[c.command_id] || {}, {status:'COMPLETED', accepted:true, updated_at:now, last_error:null});\nflow.set('command_status_map', statusMap);\nconst inflightMap = flow.get('equipment_inflight_map') || {};\nif (c.equipment_id) delete inflightMap[c.equipment_id];\nflow.set('equipment_inflight_map', inflightMap);\nmsg.payload = 'COMPLETED';\nmsg.command_result = statusMap[c.command_id];\nreturn [msg,msg];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2130,
        "y": 320,
