    {
        "id": "bbe942db420f7d89",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "0f364cd9f3d27dee",
        "name": "CAST-01 parser",
        "func": "// ── 통합 파서 ──────────────────────────────────────────\n// MC Read 4개 결과를 topic으로 구분해 context에 누적,\n// 4개 모두 수신되면 하나의 payload로 merge하여 출력.\n//\n// Read ①  topic=\"M_BITS\"        : M0,11      → power, alarm_active\n// Read ②  topic=\"SP_FLOATS\"     : DREAL0,3   → sp 3개 (float)\n// Read ③  topic=\"INTS\"          : D10,8      → status, alarm_code, heartbeat, part_count (int)\n// Read ④  topic=\"SENSOR_FLOATS\" : DREAL100,5 → sensor 3개+progress+cycle_time (float)\n// + heartbeat 기반 connected 계산\n// ──────────────────────────────────────────────────────\nconst EQUIP_ID = \"CAST-01\";\nconst TOTAL = 4;\n\nconst STATUS_MAP = {\n  0: \"IDLE\",\n  1: \"RUNNING\",\n  2: \"WARNING\",\n  3: \"ERROR\",\n  4: \"COMPLETE\"\n};\n\nconst topic = msg.topic;\nconst p = msg.payload;\nconst arr = Array.isArray(p) ? p : [p];\n\nlet buf = context.get('buf') || {};\nlet count = context.get('count') || 0;\n\nif (topic === 'M_BITS') {\n  buf.power = !!arr[0];\n  buf.alarm_active = !!arr[10];\n  count++;\n\n} else if (topic === 'SP_FLOATS') {\n  buf.injection_pressure_sp = +Number(arr[0]).toFixed(3);\n  buf.mold_temperature_sp = +Number(arr[1]).toFixed(3);\n  buf.cooling_flow_sp = +Number(arr[2]).toFixed(3);\n  count++;\n\n} else if (topic === 'INTS') {\n  const statusCode = Number(arr[0]);\n  const alarmCode = Number(arr[2]);\n  const heartbeat = Number(arr[4]);\n  const partCount = Number(arr[6]);\n\n  buf.status_code = statusCode;\n  buf.status = STATUS_MAP[statusCode] || `UNKNOWN_${statusCode}`;\n  buf.alarm_code = alarmCode;\n  buf.heartbeat = heartbeat;\n  buf.part_count = partCount;\n  count++;\n\n} else if (topic === 'SENSOR_FLOATS') {\n  buf.injection_pressure = +Number(arr[0]).toFixed(3);\n  buf.mold_temperature = +Number(arr[1]).toFixed(3);\n  buf.cooling_flow = +Number(arr[2]).toFixed(3);\n  buf.progress = +Number(arr[3]).toFixed(3);\n  buf.cycle_time = +Number(arr[4]).toFixed(3);\n  count++;\n}\n\ncontext.set('buf', buf);\ncontext.set('count', count);\n\nif (count < TOTAL) return null;\n\nconst hb = buf.heartbeat;\nconst lastHb = context.get('last_hb') || null;\nconst lastTs = context.get('last_hb_ts') || 0;\nconst now = Date.now();\n\nif (hb !== lastHb) {\n  context.set('last_hb', hb);\n  context.set('last_hb_ts', now);\n}\n\nbuf.connected = (hb !== lastHb) || (now - lastTs < 3000);\n\ncontext.set('buf', {});\ncontext.set('count', 0);\n\nmsg.payload = { equipment_id: EQUIP_ID, tags: buf };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
