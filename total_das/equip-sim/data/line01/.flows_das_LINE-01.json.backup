    {
        "id": "cb90fa6379f46578",
        "type": "function",
        "z": "7fceb9f3fadf4c8d",
        "name": "prepare writer payload",
        "func": "\nconst kind = msg.writer_kind;\nconst v = msg.command.value;\nif (kind === 'mc_direct' || kind === 'modbus_direct' || kind === 'modbus_coil' || kind === 'mc_bit') {\n  msg.payload = v;\n  return msg;\n}\nif (kind === 'modbus_float') {\n  const n = Number(v);\n  if (!Number.isFinite(n)) { node.error('invalid float payload: ' + v, msg); return null; }\n  const buf = Buffer.alloc(4); buf.writeFloatBE(n,0); msg.payload = [buf.readUInt16BE(0), buf.readUInt16BE(2)];\n  return msg;\n}\nif (kind === 'opcua_float') {\n  const n = Number(v);\n  if (!Number.isFinite(n)) { node.error('invalid opcua float payload: ' + v, msg); return null; }\n  msg.payload = n; msg.topic = 'ns=2;s=' + msg.command.command_type; msg.datatype = 'Float';\n  return msg;\n}\nif (kind === 'opcua_bool') {\n  msg.payload = !!v; msg.topic = 'ns=2;s=' + msg.command.command_type; msg.datatype = 'Boolean';\n  return msg;\n}\nnode.error('unknown writer kind: ' + kind, msg);\nreturn null;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1140,
        "y": 840,
        "wires": [
            [
                "fea99a83e788d64e"
            ]
        ]
    },
