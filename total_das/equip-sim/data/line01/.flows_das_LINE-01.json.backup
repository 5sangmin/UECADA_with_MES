        "name": "unsupported mapping",
        "func": "\nconst now = new Date().toISOString();\nconst c = msg.command || {};\nconst inflightMap = flow.get('equipment_inflight_map') || {};\nif (c.equipment_id) delete inflightMap[c.equipment_id];\nflow.set('equipment_inflight_map', inflightMap);\nconst statusMap = flow.get('command_status_map') || {};\nstatusMap[c.command_id] = Object.assign({}, statusMap[c.command_id] || {}, {status:'FAILED', accepted:false, updated_at:now, last_error:'unsupported equipment/tag mapping'});\nflow.set('command_status_map', statusMap);\nmsg.command_result = statusMap[c.command_id];\nreturn [msg,msg];\n",
