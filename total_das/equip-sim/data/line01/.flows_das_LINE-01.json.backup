    {
        "id": "4cee35f25251da76",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "65b85dc0e08ba594",
        "name": "ASSY-01 flush",
        "func": "const EQ = 'ASSY-01';\nconst STATUS_MAP = {0:'IDLE',1:'RUNNING',2:'WARNING',3:'ERROR',4:'COMPLETE'};\nconst NAMES = [\"power\", \"status\", \"alarm_active\", \"alarm_code\", \"heartbeat\", \"part_count\", \"tightening_torque_sp\", \"tightening_angle_sp\", \"press_force_sp\", \"tightening_torque\", \"tightening_angle\", \"press_force\", \"progress\", \"cycle_time\"];\nconst buf = flow.get('opcua_buf_' + EQ) || {};\nif (Object.keys(buf).length === 0) return null;\nconst tags = {};\nfor (const n of NAMES) { if (n in buf) tags[n] = buf[n]; }\nif (Object.keys(tags).length === 0) return null;\nif ('status' in tags) {\n  tags.status_code = tags.status;\n  tags.status = STATUS_MAP[tags.status] ?? String(tags.status);\n}\nconst hb = tags.heartbeat ?? null;\nif (hb !== null) {\n  const lastHb = context.get('last_hb');\n  const lastTs = context.get('last_hb_ts') || 0;\n  const now = Date.now();\n  if (hb !== lastHb) {\n    context.set('last_hb', hb);\n    context.set('last_hb_ts', now);\n  }\n  tags.connected = (hb !== lastHb) || (now - lastTs < 3000);\n}\nconst cs = context.get('cyclestate') || {acc:0,lastct:null,startms:null};\nconst prog = tags.progress ?? null;\nif (prog !== null) {\n  if (cs.startms === null && prog > 0 && prog < 1.0) cs.startms = Date.now();\n  if (cs.startms !== null && prog >= 1.0 && cs.acc < 1.0) {\n    cs.lastct = (Date.now() - cs.startms) / 1000;\n    cs.startms = null;\n  }\n  cs.acc = prog;\n  context.set('cyclestate', cs);\n}\nif (cs.lastct !== null && !('cycle_time' in tags)) tags.cycle_time = cs.lastct;\nmsg.payload = { equipment_id: EQ, tags };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 980,
        "wires": [
            [
                "d7538de5cd74e1da",
                "5d3c03eeee219940"
            ]
        ]
    },
    {
        "id": "a73d71aa45bd74aa",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "65b85dc0e08ba594",
        "name": "ASSY-01 watchdog resub",
        "func": "// 마지막 정상 수신이 일정 시간 없으면 재구독 트리거\nconst now = Date.now();\nconst lastSeen = flow.get('opcua_last_seen_ASSY-01') || 0;\nconst cooldown = flow.get('opcua_resub_cooldown_ASSY-01') || 0;\nconst silentMs = now - lastSeen;\nif (lastSeen === 0) return null; // 아직 초기 수신 전이면 대기\nif (silentMs < 15000) return null; // 15초 이내 수신 있음\nif (now - cooldown < 15000) return null; // 과도한 재구독 방지\nflow.set('opcua_resub_cooldown_ASSY-01', now);\nmsg.topic = 'multiple';\nmsg.payload = [ {\"nodeId\": \"ns=2;s=power\", \"datatype\": \"Boolean\", \"name\": \"power\"}, \n                {\"nodeId\": \"ns=2;s=status\", \"datatype\": \"Int32\", \"name\": \"status\"}, \n                {\"nodeId\": \"ns=2;s=alarm_active\", \"datatype\": \"Boolean\", \"name\": \"alarm_active\"}, \n                {\"nodeId\": \"ns=2;s=alarm_code\", \"datatype\": \"Int32\", \"name\": \"alarm_code\"}, \n                {\"nodeId\": \"ns=2;s=heartbeat\", \"datatype\": \"Int32\", \"name\": \"heartbeat\"}, \n                {\"nodeId\": \"ns=2;s=part_count\", \"datatype\": \"Int32\", \"name\": \"part_count\"}, \n                {\"nodeId\": \"ns=2;s=tightening_torque_sp\", \"datatype\": \"Float\", \"name\": \"tightening_torque_sp\"}, \n                {\"nodeId\": \"ns=2;s=tightening_angle_sp\", \"datatype\": \"Float\", \"name\": \"tightening_angle_sp\"}, \n                {\"nodeId\": \"ns=2;s=press_force_sp\", \"datatype\": \"Float\", \"name\": \"press_force_sp\"}, \n                {\"nodeId\": \"ns=2;s=tightening_torque\", \"datatype\": \"Float\", \"name\": \"tightening_torque\"}, \n                {\"nodeId\": \"ns=2;s=tightening_angle\", \"datatype\": \"Float\", \"name\": \"tightening_angle\"}, \n                {\"nodeId\": \"ns=2;s=press_force\", \"datatype\": \"Float\", \"name\": \"press_force\"}, \n                {\"nodeId\": \"ns=2;s=progress\", \"datatype\": \"Float\", \"name\": \"progress\"}, \n                {\"nodeId\": \"ns=2;s=cycle_time\", \"datatype\": \"Float\", \"name\": \"cycle_time\"}];\nreturn msg;",
