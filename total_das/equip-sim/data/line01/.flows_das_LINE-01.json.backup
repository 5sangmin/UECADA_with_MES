    {
        "id": "f25a9a89280e3650",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "65b85dc0e08ba594",
        "name": "ASSY-01 collect guarded",
        "func": "// OPC UA subscription 결과 누적 → flush 에서 1초 스냅샷 발사\n// 방어 로직: 관리 메시지 / 비정상 상태 / NodeId 아닌 메시지 차단\nif (msg.topic === 'subscriptionId') return null;\n\n// top-level StatusCode 또는 payload.statusCode.value 체크\nlet sc = msg.StatusCode;\nif (sc === undefined && msg.payload && msg.payload.statusCode) {\n  sc = msg.payload.statusCode.value;\n}\nif (sc !== undefined && sc !== 0) return null;\n\nif (!msg.topic || !String(msg.topic).startsWith('ns=')) return null;\n\nconst buf = flow.get('opcua_buf_ASSY-01') || {};\nconst raw = String(msg.topic);\nconst name = raw.replace(/^.*s=/, '');\n\n// DataValue → scalar normalize\nlet v = msg.payload;\nif (v && typeof v === 'object') {\n  // node-red-contrib-opcua DataValue 패턴: payload.value.value 에 실제 값\n  if (v.value && typeof v.value === 'object' && 'value' in v.value) {\n    v = v.value.value;\n  } else if ('value' in v && !('dataType' in v)) {\n    // 혹시 단순 {value: x} 형태일 때\n    v = v.value;\n  }\n}\n\nbuf[name] = v;\nflow.set('opcua_buf_ASSY-01', buf);\nflow.set('opcua_last_seen_ASSY-01', Date.now());\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
