    {
        "id": "c9d026043903f624",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "b89ff7d994b0e35d",
        "name": "CNC-02 parser",
        "func": "const EQUIP_ID = 'CNC-02';\nconst TOTAL = 3;\n\nconst STATUS_MAP = {\n  0: \"IDLE\",\n  1: \"RUNNING\",\n  2: \"WARNING\",\n  3: \"ERROR\",\n  4: \"COMPLETE\"\n};\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nfunction wordsToFloat(words, wordOffset) {\n  const i = wordOffset * 2;\n  const buf = Buffer.alloc(4);\n  buf.writeUInt16BE((words[i] || 0) & 0xFFFF, 0);\n  buf.writeUInt16BE((words[i + 1] || 0) & 0xFFFF, 2);\n  return +buf.readFloatBE(0).toFixed(3);\n}\n\nconst r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nlet buf = context.get('buf') || {};\nlet count = context.get('count') || 0;\n\nif (msg.topic === 'COILS') {\n  buf.power = !!r[0];\n  buf.alarm_active = !!r[10];\n  count++;\n\n} else if (msg.topic === 'HR_INT') {\n  const statusCode = s16(r[4]);\n  const hb = s16(r[8]);\n\n  buf.spindle_speed_sp = s16(r[0]);\n  buf.spindle_speed = s16(r[2]);\n  buf.status_code = statusCode;\n  buf.status = STATUS_MAP[statusCode] || `UNKNOWN_${statusCode}`;\n  buf.alarm_code = s16(r[6]);\n  buf.heartbeat = hb;\n  buf.part_count = s16(r[10]);\n  count++;\n\n} else if (msg.topic === 'HR_FLOAT') {\n  buf.tool_usage_sp = wordsToFloat(r, 0);\n  buf.tool_usage = wordsToFloat(r, 1);\n  buf.coolant_flow_sp = wordsToFloat(r, 2);\n  buf.coolant_flow = wordsToFloat(r, 3);\n  buf.progress = wordsToFloat(r, 4);\n  buf.cycle_time = wordsToFloat(r, 5);\n  count++;\n}\n\ncontext.set('buf', buf);\ncontext.set('count', count);\nif (count < TOTAL) return null;\n\nconst hb = buf.heartbeat;\nconst lastHb = context.get('last_hb');\nconst lastTs = context.get('last_hb_ts') || 0;\nconst now = Date.now();\n\nif (hb !== undefined && hb !== lastHb) {\n  context.set('last_hb', hb);\n  context.set('last_hb_ts', now);\n}\n\nbuf.connected = (hb !== undefined) && ((hb !== lastHb) || (now - lastTs < 3000));\n\ncontext.set('buf', {});\ncontext.set('count', 0);\n\nmsg.payload = {\n  equipment_id: EQUIP_ID,\n  tags: buf\n};\nreturn msg;",
