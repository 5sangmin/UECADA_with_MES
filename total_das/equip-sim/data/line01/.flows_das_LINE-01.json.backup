        "y": 940,
        "wires": []
    },
    {
        "id": "5685825f478a8648",
        "type": "inject",
        "z": "5b220735e29c459d",
        "g": "65b85dc0e08ba594",
        "name": "ASSY-01 flush tick",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "1",
        "crontab": "",
        "once": true,
        "onceDelay": "3",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 990,
