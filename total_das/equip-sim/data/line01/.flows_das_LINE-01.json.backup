    {
        "id": "f2c0aba7ceba24bf",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "d29b5586d422e01a",
        "name": "TEST-01 watchdog resub",
        "func": "// 마지막 정상 수신이 일정 시간 없으면 재구독 트리거\nconst now = Date.now();\nconst lastSeen = flow.get('opcua_last_seen_TEST-01') || 0;\nconst cooldown = flow.get('opcua_resub_cooldown_TEST-01') || 0;\nconst silentMs = now - lastSeen;\nif (lastSeen === 0) return null; // 아직 초기 수신 전이면 대기\nif (silentMs < 15000) return null; // 15초 이내 수신 있음\nif (now - cooldown < 15000) return null; // 과도한 재구독 방지\nflow.set('opcua_resub_cooldown_TEST-01', now);\nmsg.topic = 'multiple';\nmsg.payload = [{\"nodeId\": \"ns=2;s=power\", \"datatype\": \"Boolean\", \"name\": \"power\"}, {\"nodeId\": \"ns=2;s=status\", \"datatype\": \"Int32\", \"name\": \"status\"}, {\"nodeId\": \"ns=2;s=alarm_active\", \"datatype\": \"Boolean\", \"name\": \"alarm_active\"}, {\"nodeId\": \"ns=2;s=alarm_code\", \"datatype\": \"Int32\", \"name\": \"alarm_code\"}, {\"nodeId\": \"ns=2;s=heartbeat\", \"datatype\": \"Int32\", \"name\": \"heartbeat\"}, {\"nodeId\": \"ns=2;s=part_count\", \"datatype\": \"Int32\", \"name\": \"part_count\"}, {\"nodeId\": \"ns=2;s=bore_dimension_sp\", \"datatype\": \"Float\", \"name\": \"bore_dimension_sp\"}, {\"nodeId\": \"ns=2;s=hole_dimension_sp\", \"datatype\": \"Float\", \"name\": \"hole_dimension_sp\"}, {\"nodeId\": \"ns=2;s=bore_dimension\", \"datatype\": \"Float\", \"name\": \"bore_dimension\"}, {\"nodeId\": \"ns=2;s=hole_dimension\", \"datatype\": \"Float\", \"name\": \"hole_dimension\"}, {\"nodeId\": \"ns=2;s=progress\", \"datatype\": \"Float\", \"name\": \"progress\"}, {\"nodeId\": \"ns=2;s=cycle_time\", \"datatype\": \"Float\", \"name\": \"cycle_time\"}];\nreturn msg;",
