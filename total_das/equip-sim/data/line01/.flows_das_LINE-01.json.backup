    {
        "id": "542b702c46c3017f",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "d29b5586d422e01a",
        "name": "TEST-01 prep multiple subscribe",
        "func": "msg.topic = 'multiple';\nmsg.payload = [\n  {\n    \"nodeId\": \"ns=2;s=power\",\n    \"datatype\": \"Boolean\",\n    \"name\": \"power\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=status\",\n    \"datatype\": \"Int32\",\n    \"name\": \"status\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=alarm_active\",\n    \"datatype\": \"Boolean\",\n    \"name\": \"alarm_active\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=alarm_code\",\n    \"datatype\": \"Int32\",\n    \"name\": \"alarm_code\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=heartbeat\",\n    \"datatype\": \"Int32\",\n    \"name\": \"heartbeat\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=part_count\",\n    \"datatype\": \"Int32\",\n    \"name\": \"part_count\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=bore_dimension_sp\",\n    \"datatype\": \"Float\",\n    \"name\": \"bore_dimension_sp\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=hole_dimension_sp\",\n    \"datatype\": \"Float\",\n    \"name\": \"hole_dimension_sp\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=bore_dimension\",\n    \"datatype\": \"Float\",\n    \"name\": \"bore_dimension\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=hole_dimension\",\n    \"datatype\": \"Float\",\n    \"name\": \"hole_dimension\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=progress\",\n    \"datatype\": \"Float\",\n    \"name\": \"progress\"\n  },\n  {\n    \"nodeId\": \"ns=2;s=cycle_time\",\n    \"datatype\": \"Float\",\n    \"name\": \"cycle_time\"\n  }\n];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 1220,
        "wires": [
            [
                "f9d302d0503a6b53"
            ]
        ]
    },
    {
        "id": "f9d302d0503a6b53",
