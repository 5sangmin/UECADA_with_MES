                "t": "eq",
                "v": "COMPLETED",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "FAILED",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "TIMEOUT",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "REJECTED_BUSY",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "REJECTED_INVALID",
                "vt": "str"
            },
            {
                "t": "else"
            }
        ],
        "checkall": "true",
        "repair": false,
