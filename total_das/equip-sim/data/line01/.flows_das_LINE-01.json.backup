    {
        "id": "2ceb2432ee99945d",
        "type": "function",
        "z": "7fceb9f3fadf4c8d",
        "name": "mark TIMEOUT",
        "func": "\nif (msg.payload !== 'timeout') return null;\nconst now = new Date().toISOString();\nconst c = msg.command;\nif (!c || !c.command_id) return null;\nconst inflightMap = flow.get('equipment_inflight_map') || {};\nconst active = c.equipment_id ? inflightMap[c.equipment_id] : null;\nif (!active || active.command_id !== c.command_id) return null;\ndelete inflightMap[c.equipment_id];\nflow.set('equipment_inflight_map', inflightMap);\nconst statusMap = flow.get('command_status_map') || {};\nstatusMap[c.command_id] = Object.assign({}, statusMap[c.command_id] || {}, {status:'TIMEOUT', accepted:false, updated_at:now, last_error:'write timeout'});\nflow.set('command_status_map', statusMap);\nmsg.command_result = statusMap[c.command_id];\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
