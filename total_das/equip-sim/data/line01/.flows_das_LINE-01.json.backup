            ]
        ]
    },
    {
        "id": "4db2cc52cc24eff6",
        "type": "function",
        "z": "7fceb9f3fadf4c8d",
        "name": "mark FAILED",
        "func": "\nconst now = new Date().toISOString();\nconst c = msg.command;\nif (!c || !c.command_id) return null;\nconst statusMap = flow.get('command_status_map') || {};\nstatusMap[c.command_id] = Object.assign({}, statusMap[c.command_id] || {}, {status:'FAILED', accepted:false, updated_at:now, last_error:(msg.error && (msg.error.message || msg.error.toString())) || 'write failed'});\nflow.set('command_status_map', statusMap);\nconst inflightMap = flow.get('equipment_inflight_map') || {};\nif (c.equipment_id) delete inflightMap[c.equipment_id];\nflow.set('equipment_inflight_map', inflightMap);\nmsg.command_result = statusMap[c.command_id];\nreturn msg;\n",
