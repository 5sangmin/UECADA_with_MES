    {
        "id": "5c73f4752c5a42a2",
        "type": "comment",
        "z": "7fceb9f3fadf4c8d",
        "name": "LINE-01 writable full flow",
        "info": "LINE-01 writable 전체 flow 대체본. writer_target을 사람이 읽을 수 있는 alias로 통일하고, setpoint writer까지 모두 실제 writer node와 연결했다. 설비당 1 in-flight, 성공/실패/타임아웃 상태를 writable status out으로 내보낸다.",
        "x": 230,
        "y": 60,
        "wires": []
    },
    {
        "id": "d5f5c867c138a839",
        "type": "link in",
        "z": "7fceb9f3fadf4c8d",
        "name": "writable command in",
        "links": [
            "dbglinkout001",
            "381042f6c7353e86",
            "8b0624abb6d38ff9",
            "09fce715fe3c8290"
        ],
        "x": 115,
        "y": 120,
        "wires": [
            [
                "a416a0a5ec37e431"
            ]
        ]
    },
    {
        "id": "a416a0a5ec37e431",
        "type": "function",
        "z": "7fceb9f3fadf4c8d",
        "name": "normalize + lock inflight",
        "func": "\nconst now = new Date().toISOString();\nconst body = msg.payload || {};\nconst cmd = body.command || body;\nconst equipmentId = cmd.equipment_id || cmd.equipmentId || cmd.target_equipment || cmd.targetEquipment || cmd.machine_id || cmd.machineId;\nlet rawType = cmd.command_type || cmd.commandType || cmd.tag || cmd.tag_name || cmd.tagName || cmd.name;\nconst commandId = cmd.command_id || cmd.commandId || msg.command_id || msg._msgid;\nlet value = Object.prototype.hasOwnProperty.call(cmd,'value') ? cmd.value : cmd.payload;\nif (!equipmentId || !rawType) {\n  msg.command_result = {command_id: commandId || null, equipment_id: equipmentId || null, command_type: rawType || null, status:'REJECTED_INVALID', accepted:false, requested_at:now, updated_at:now, last_error:'equipment_id or command_type missing'};\n  return [null, msg];\n}\nconst alias = {\n  injection_pressure_sp:'injectionpressuresp', mold_temperature_sp:'moldtemperaturesp', cooling_flow_sp:'coolingflowsp',\n  spindle_speed_sp:'spindlespeedsp', tool_usage_sp:'toolusagesp', coolant_flow_sp:'coolantflowsp',\n  cleaning_concentration_sp:'cleaningconcentrationsp', cleaning_temperature_sp:'cleaningtemperaturesp', cleaning_pressure_sp:'cleaningpressuresp',\n  tightening_torque_sp:'tighteningtorquesp', tightening_angle_sp:'tighteninganglesp', press_force_sp:'pressforcesp',\n  bore_dimension_sp:'boredimensionsp', hole_dimension_sp:'holedimensionsp',\n  inject_warn:'injectwarning', inject_warning:'injectwarning', inject_error:'injecterror',\n  reset_error:'reseterror', load:'loadrequest', unload:'unloadrequest'\n};\nlet commandType = String(rawType).replace(/[^a-zA-Z0-9]/g,'').toLowerCase();\nif (alias[String(rawType)]) commandType = alias[String(rawType)];\nconst boolTags = new Set(['power','loadrequest','unloadrequest','reseterror','injectwarning','injecterror']);\nif (boolTags.has(commandType)) value = !!value;\nconst inflightMap = flow.get('equipment_inflight_map') || {};\nif (inflightMap[equipmentId]) {\n  msg.command_result = {command_id: commandId, equipment_id: equipmentId, command_type: commandType, status:'REJECTED_BUSY', accepted:false, requested_at:now, updated_at:now, last_error:'another command is already in-flight for this equipment', inflight_command_id: inflightMap[equipmentId].command_id};\n  return [null, msg];\n}\nconst timeoutSec = Number(cmd.timeout_sec || cmd.timeoutSec || 10);\ninflightMap[equipmentId] = {command_id: commandId, command_type: commandType, started_at: now, timeout_sec: timeoutSec};\nflow.set('equipment_inflight_map', inflightMap);\nconst statusMap = flow.get('command_status_map') || {};\nstatusMap[commandId] = {command_id:commandId, equipment_id:equipmentId, command_type:commandType, value:value, status:'SENDING', accepted:true, requested_at:now, updated_at:now, retry_count:0, last_error:null};\nflow.set('command_status_map', statusMap);\nmsg.command = {command_id:commandId, equipment_id:equipmentId, command_type:commandType, value:value, timeout_sec:timeoutSec};\nmsg.command_result = statusMap[commandId];\nmsg.topic = commandId;\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 120,
        "wires": [
            [
                "e2ad3212d7dafda7",
                "bc8a956a6b586af6",
                "e0376bbc3575e01b"
            ],
            [
                "e0376bbc3575e01b"
            ]
        ]
    },
    {
        "id": "e2ad3212d7dafda7",
        "type": "switch",
        "z": "7fceb9f3fadf4c8d",
        "name": "route by equipment",
        "property": "command.equipment_id",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "CAST-01",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "CNC-01",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "CNC-02",
                "vt": "str"
            },
