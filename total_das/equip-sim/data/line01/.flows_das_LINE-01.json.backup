    {
        "id": "9d8dbb7b87bd6f7e",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "d29b5586d422e01a",
        "name": "TEST-02 flush",
        "func": "const EQ = 'TEST-02';\nconst STATUS_MAP = {0:'IDLE',1:'RUNNING',2:'WARNING',3:'ERROR',4:'COMPLETE'};\nconst NAMES = [\"power\", \"status\", \"alarm_active\", \"alarm_code\", \"heartbeat\", \"part_count\", \"bore_dimension_sp\", \"hole_dimension_sp\", \"bore_dimension\", \"hole_dimension\", \"progress\", \"cycle_time\"];\nconst buf = flow.get('opcua_buf_' + EQ) || {};\nif (Object.keys(buf).length === 0) return null;\nconst tags = {};\nfor (const n of NAMES) { if (n in buf) tags[n] = buf[n]; }\nif (Object.keys(tags).length === 0) return null;\n\nconst statusCode = ('status' in tags) ? Number(tags.status) : null;\nconst progress = ('progress' in tags) ? Number(tags.progress) : null;\n\nlet resultLatch = context.get('result_ok_latch');\nif (resultLatch === undefined || resultLatch === null) resultLatch = true;\n\nif (statusCode === 0) {\n  resultLatch = true;\n} else if (statusCode === 1 || statusCode === 2) {\n  const bore = Number(tags.bore_dimension);\n  const hole = Number(tags.hole_dimension);\n\n  const boreValid = Number.isFinite(bore);\n  const holeValid = Number.isFinite(hole);\n  const progressValid = Number.isFinite(progress) && progress >= 5; // 예: 5% 이후만 판정\n\n  if (boreValid && holeValid && progressValid) {\n    const boreOk = bore >= 39.975 && bore <= 40.02;\n    const holeOk = hole >= 10.16 && hole <= 10.24;\n    if (!(boreOk && holeOk)) resultLatch = false;\n  }\n}\nelse if (statusCode === 3){\n  resultLatch = false\n}\n\ncontext.set('result_ok_latch', resultLatch);\ntags.result_ok = resultLatch;\n\nif ('status' in tags) {\n  tags.status_code = tags.status;\n  tags.status = STATUS_MAP[tags.status] ?? String(tags.status);\n}\n\nconst hb = tags.heartbeat ?? null;\nif (hb !== null) {\n  const lastHb = context.get('last_hb');\n  const lastTs = context.get('last_hb_ts') || 0;\n  const now = Date.now();\n  if (hb !== lastHb) {\n    context.set('last_hb', hb);\n    context.set('last_hb_ts', now);\n  }\n  tags.connected = (hb !== lastHb) || (now - lastTs < 3000);\n}\n\nconst cs = context.get('cyclestate') || {acc:0,lastct:null,startms:null};\nconst prog = tags.progress ?? null;\nif (prog !== null) {\n  if (cs.startms === null && prog > 0 && prog < 1.0) cs.startms = Date.now();\n  if (cs.startms !== null && prog >= 1.0 && cs.acc < 1.0) {\n    cs.lastct = (Date.now() - cs.startms) / 1000;\n    cs.startms = null;\n  }\n  cs.acc = prog;\n  context.set('cyclestate', cs);\n}\nif (cs.lastct !== null && !('cycle_time' in tags)) tags.cycle_time = cs.lastct;\nmsg.payload = { equipment_id: EQ, tags };\nreturn msg;",
