# Command Center 환경변수 템플릿.
#
# 사용:
#   docker compose --env-file .env.command-center -f docker-compose.command-center.yml up -d --build
#
# 운영 시 비밀값(COMMANDDB_PASSWORD)은 별도 secret 관리로 옮길 것.

COMPOSE_PROJECT_NAME=command-center

# Node-RED 운영 UI (호스트 포트)
PORT_NODERED_UI=5888

# OPC UA Server 포트 (호스트/컨테이너 동일 — endpoint advertise mismatch 회피)
OPCUA_SERVER_PORT=5160

# Flow 파일명 (data/command-center 안)
FLOWS=flows.json

# CommandDB 접속 — 호스트 OS 의 PostgreSQL 인스턴스에 접근
# Windows Docker Desktop 은 host.docker.internal 기본 지원,
# Linux 는 compose 의 extra_hosts(host-gateway) 로 매핑.
COMMANDDB_HOST=host.docker.internal
COMMANDDB_PORT=55433
COMMANDDB_NAME=total_das_command
COMMANDDB_USER=total_das_cmd_user
COMMANDDB_PASSWORD=total_das_cmd_1234

# Worker 식별자. 동시 인스턴스 운영 시 구분, graceful recovery 의 키로 사용.
WORKER_ID=command-center
