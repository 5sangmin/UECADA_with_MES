# =============================================================================
# unreal-backend BeApi 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 BeApi/.env 로 복사:  copy .env.example .env
#   2) 아래 값들을 실제 운영/개발 환경에 맞게 수정
#   3) dotnet run 실행 시 자동으로 로드됨 (DotNetEnv 패키지)
#
# 우선순위 (.NET Configuration 표준):
#   OS 환경변수  >  .env 파일  >  appsettings.{Environment}.json  >  appsettings.json
#
# 키 명명 규칙:
#   - .NET 의 nested key 는 "__" (이중 언더스코어) 로 표현.
#     예) "Database:TsdbConnectionString"  →  DATABASE__TSDBCONNECTIONSTRING
#   - 단독 키(VIDEO_ROOT) 는 코드에서 직접 Environment.GetEnvironmentVariable 로 읽음.
#
# 보안:
#   - .env 는 .gitignore 에 등재되어 있어 git 에 커밋되지 않음 (저장소 root .gitignore 확인).
#   - 비밀번호/접속정보는 절대로 .env.example 에 실제 값을 적지 말 것.
# =============================================================================


# -----------------------------------------------------------------------------
# Database — 비밀값. dev 기본값은 appsettings.Development.json 에 있으나
#             prod 또는 다른 환경에서는 반드시 ENV 로 오버라이드.
# -----------------------------------------------------------------------------
# TSDB (TimescaleDB) — 텔레메트리 시계열 + 영상 status_code 참조용
DATABASE__TSDBCONNECTIONSTRING=Host=localhost;Port=55432;Database=total_das_ts;Username=total_das_user;Password=__CHANGE_ME__

# CommandDB (PostgreSQL) — 사용자 명령 큐
DATABASE__COMMANDDBCONNECTIONSTRING=Host=localhost;Port=55433;Database=total_das_command;Username=total_das_cmd_user;Password=__CHANGE_ME__


# -----------------------------------------------------------------------------
# OPC UA — 머신/서버마다 endpoint 가 다름
# -----------------------------------------------------------------------------
OPCUA__ENDPOINTURL=opc.tcp://localhost:54880/UA/DAS


# -----------------------------------------------------------------------------
# UDP Relay / Replay — 네트워크 환경마다 다름
#
# 토폴로지:
#   상위 시스템(KIST/SNU 등) → :50010 (Relay 입력)
#                              ↓ Relay
#                              :50020 (라이브 멀티캐스트, MulticastGroup 으로)
#                              :50021 (Replay 멀티캐스트 출력)
# -----------------------------------------------------------------------------
# 라이브 수신/리스닝
UDP__MULTICASTGROUP=239.100.0.1
UDP__LISTENPORT=50020
UDP__BINDADDRESS=0.0.0.0

# Relay 입력 → 출력
UDP__RELAY__LISTENPORT=50010
UDP__RELAY__OUTPUTPORT=50020
# Windows 멀티 NIC 환경에서 송신 인터페이스 명시. 잘못 지정하면 패킷이 안 보임.
# 일반적으로 산업 PLC 네트워크의 NIC IP. 확인: ipconfig /all
UDP__RELAY__MULTICASTINTERFACE=192.168.5.10
UDP__RELAY__MULTICASTTTL=1

# Replay 출력
UDP__REPLAY__OUTPUTPORT=50021


# -----------------------------------------------------------------------------
# Video — 영상 파일 루트. 비어있으면 프로젝트 내 BeApi/videos 폴더 사용 (개발 편의).
#         운영에서는 D:\videos 같은 별도 경로 권장 (대용량 영상 분리).
#         디렉터리 구조: {VIDEO_ROOT}/{TYPE}/status_{0..4}.webm + status_default.webm (+ .jpg)
#         TYPE ∈ {CAST, CNC, WASH, ASSY, TEST}
# -----------------------------------------------------------------------------
VIDEO_ROOT=
