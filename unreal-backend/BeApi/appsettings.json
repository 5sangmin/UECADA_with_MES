{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "OpcUa": {
    "EndpointUrl": "opc.tcp://node-red:4840",
    "ReconnectDelayMs": 5000,
    "SessionTimeoutMs": 30000
  },
  "Udp": {
    "MulticastGroup": "239.100.0.1",
    "ListenPort": 50020,
    "BindAddress": "0.0.0.0",
    "StaleThresholdSeconds": 10,
    "Relay": {
      "ListenPort": 50010,
      "OutputPort": 50020,
      "MulticastInterface": "192.168.5.10",
      "MulticastTtl": 1
    },
    "Replay": {
      "OutputPort": 50021,
      "DefaultSpeed": 1.0,
      "MinSpeed": 0.1,
      "MaxSpeed": 100.0,
      "FetchBatchSize": 5000
    }
  },
  "Database": {
    "TsdbConnectionString": "",
    "CommandDbConnectionString": ""
  },
  "ConnectionCheck": {
    "IntervalSeconds": 30,
    "TimeoutMs": 5000
  },
  "EquipmentLut": {
    "//": "TSDB 스키마 상 line_id/equipment_id 는 '1','101' 의 정수 문자열. 비어두면 항등 파싱, 값을 넣으면 whitelist 동작.",
    "Lines": {},
    "Equipments": {}
  },
  "AllowedHosts": "*"
}
