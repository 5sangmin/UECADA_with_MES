# 백엔드 API (비우면 알람 등은 목업 모드로 동작)
VITE_API_BASE_URL=

# vite dev server bind host / port (기본 0.0.0.0 = LAN 의 모든 인터페이스)
# 로컬에서만 접근 허용하려면 VITE_DEV_HOST=127.0.0.1 로 변경.
VITE_DEV_HOST=
VITE_DEV_PORT=

# vite preview 도 동일한 패턴.
VITE_PREVIEW_HOST=
VITE_PREVIEW_PORT=

# /api, /health 프록시 타깃 (기본 http://localhost:8080)
VITE_DEV_API_PROXY=

# true 이면 알람 API를 호출하지 않고 지연 목업 데이터 사용
VITE_USE_MOCK_ALARMS=true

# SMWP 웹스카다 (?Pro=프로젝트, #뒤=화면 ID)
VITE_SWMP_DEFAULT_URL=http://192.168.0.100:11005/?Pro=myseo_260430#LDV
